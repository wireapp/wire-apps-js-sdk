{
  "name": "wire-apps-js-sdk-sample",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "~22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --trace-warnings build/app.js",
    "dev": "npm run build && npm run start",
    "example:callback": "npm run build && node --trace-warnings build/examples/RunCallbackExample.js",
    "example:create-group-conversation": "npm run build && node --trace-warnings build/examples/standalone/CreateGroupConversationExample.js",
    "example:broadcast-to-all-conversations": "npm run build && node --trace-warnings build/examples/standalone/SendMessageToAllConversationsExample.js"
  },
  "dependencies": {
    "@wireapp/wire-apps-js-sdk": "file:..",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2"
  }
}
