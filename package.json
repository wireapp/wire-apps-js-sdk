{
  "name": "@wireapp/wire-apps-js-sdk",
  "version": "0.0.1-alpha",
  "description": "SDK for Wire third-party applications written in Typescript.",
  "license": "GPL-3.0",
  "keywords": [
    "wire",
    "wireapp",
    "sdk",
    "apps",
    "typescript",
    "javascript",
    "messaging",
    "mls"
  ],
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "workspaces": [
    "sample"
  ],
  "scripts": {
    "proto:mkdir": "mkdir -p src/generated",
    "proto:package": "node scripts/create-generated-package-json.js",
    "proto:js": "pbjs -t static-module -w commonjs -o src/generated/messages.js src/proto/messages.proto",
    "proto:ts": "pbts -t static-module -w commonjs -o src/generated/messages.d.ts src/generated/messages.js",
    "proto:copy": "cpy 'src/generated/*' build/generated/",
    "db:migration": "npx drizzle-kit generate",
    "migrations:copy": "node scripts/copy-migrations.js",
    "proto:generate": "npm run proto:mkdir && npm run proto:package && npm run proto:js && npm run proto:ts",
    "build:setup": "npm install && npm run proto:generate",
    "build": "tsc -p tsconfig.json && npm run proto:copy && npm run migrations:copy",
    "build:sample": "npm run build && npm run -w sample build",
    "sample": "npm run build:sample && npm run -w sample start",
    "test": "npm run test:typecheck",
    "test:typecheck": "vitest run --typecheck --typecheck.tsconfig tsconfig.test.json",
    "test:coverage": "vitest run --coverage --typecheck --typecheck.tsconfig tsconfig.test.json",
    "clean": "rm -rf ./build ./node_modules ./sample/build ./sample/storage ./src/generated",
    "lint": "eslint src --ext .ts"
  },
  "files": [
    "build/**/*"
  ],
  "type": "module",
  "engines": {
    "node": "~22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wireapp/wire-apps-js-sdk.git"
  },
  "homepage": "https://github.com/wireapp/wire-apps-js-sdk#readme",
  "bugs": {
    "url": "https://github.com/wireapp/wire-apps-js-sdk/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cpy-cli": "^7.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "msw": "^2.14.6",
    "protobufjs-cli": "^2.5.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ubjs/core": "^0.31.0-3",
    "@ubjs/node": "^0.31.0-3",
    "@wireapp/core-crypto": "^10.0.0",
    "bazinga64": "^6.5.13",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.1",
    "protobufjs": "^8.6.4",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "ws": "^8.21.0"
  }
}
