{
  "name": "wire-app-js-sdk",
  "version": "0.0.1",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "storage:mkdir": "mkdir -p storage",
    "proto:mkdir": "mkdir -p src/generated",
    "proto:package": "node scripts/create-generated-package-json.js",
    "proto:js": "pbjs -t static-module -w commonjs -o src/generated/messages.js src/proto/messages.proto",
    "proto:ts": "pbts -t static-module -w commonjs -o src/generated/messages.d.ts src/generated/messages.js",
    "proto:copy": "cpy 'src/generated/*' build/generated/",
    "proto:generate": "npm run proto:mkdir && npm run proto:package && npm run proto:js && npm run proto:ts",
    "corecrypto:fix-main": "node scripts/fix-core-crypto-main.js",
    "build:setup": "npm install && npm run storage:mkdir && npm run corecrypto:fix-main && npm run proto:generate",
    "build": "tsc -p tsconfig.json && npm run proto:copy",
    "build:sample": "tsc -p tsconfig.sample.json && npm run proto:copy",
    "sample": "npm run build:sample && node --trace-warnings build/sample/app.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf build",
    "lint": "eslint src --ext .ts"
  },
  "files": [
    "build/**/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wireapp/wire-apps-js-sdk"
  },
  "bugs": {
    "url": "https://github.com/wireapp/wire-apps-js-sdk/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "cpy-cli": "^6.0.0",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "protobufjs-cli": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@wireapp/core-crypto": "^9.1.2",
    "bazinga64": "^6.5.13",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "protobufjs": "^7.5.4",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "ws": "^8.19.0"
  }
}
